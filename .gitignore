# =========================
# Crucible — root .gitignore
# =========================

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# --- Python / FastAPI backend ---
.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Local SQLite DB & journal files (user state, not source code) ---
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --- Node / Vite frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Logs / runtime artifacts ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Misc ---
*.bak
*.tmp
