## Backend environment (copy to .env)
#
# Never commit your real .env (it is gitignored).

# Optional: DB location (default is ai_scientist.sqlite in backend/)
# AI_SCIENTIST_DB_PATH=ai_scientist.sqlite

# Required for plan generation. Crucible defaults to OpenRouter; the key just needs
# to be valid for whatever OpenAI-compatible host you set in OPENAI_BASE_URL.
OPENAI_API_KEY=replace_me_with_your_key

# OpenAI-compatible endpoint and model. Defaults shown below.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-oss-120b:free

# Optional: Tavily for live web search in literature QC
# TAVILY_API_KEY=tvly-your_key_here

